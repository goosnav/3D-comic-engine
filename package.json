{
  "name": "goosnav-comic-theatre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node tools/build-web.mjs",
    "setup": "node tools/setup.mjs",
    "start": "node bin/theatre.mjs gui",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/*.browser.mjs",
    "setup:browser": "playwright install chromium",
    "verify:assets": "node bin/theatre.mjs assets"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@echogarden/flite-wasi": "0.1.1",
    "@napi-rs/canvas": "1.0.13",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "proper-lockfile": "4.1.2",
    "three": "0.186.1"
  }
}
